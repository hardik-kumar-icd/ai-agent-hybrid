# =============================================================================
# Visor AI Agent — example environment configuration
# =============================================================================
#
# Copy to .env and fill in real values. NEVER commit .env to git.
#
# Required secrets are marked REQUIRED. Tunables are marked TUNABLE with
# their current production defaults.
# =============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# ---------------------------------------------------------------------------
# OpenAI (REQUIRED)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Pinecone (REQUIRED)
# ---------------------------------------------------------------------------
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=ai-agent-knowledge

# ---------------------------------------------------------------------------
# Postgres (REQUIRED)
# Example: postgres://user:pass@localhost:5432/visor_agent
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://...

# ---------------------------------------------------------------------------
# Magento (REQUIRED for order lookups)
# Use https://visor.no/rest/V1 for production
# ---------------------------------------------------------------------------
MAGENTO_API_URL=https://visor.no/rest/V1
MAGENTO_API_TOKEN=...

# ---------------------------------------------------------------------------
# Admin dashboard (REQUIRED)
# Random 64-char hex string. Rotate if leaked.
# ---------------------------------------------------------------------------
ADMIN_API_KEY=...

# ---------------------------------------------------------------------------
# RAG confidence floors (TUNABLE)
# ---------------------------------------------------------------------------
# Minimum cosine similarity required for a retrieval to be considered
# "confident enough" to use. Below this, the agent returns NO_KNOWLEDGE_BASE_DATA
# instead of weak chunks it might synthesize from.
#
# Production-tuned values (do not raise without testing):
#   - FAQs: 0.55  — curated content, semantic match is precise
#   - Products: 0.50  — product names + specs, broader vocabulary
#   - Tickets: 0.45  — colloquial customer language, lower threshold needed
#     (Lowered from 0.55 on 2026-06-04 after the Drop 2 Phase C headline
#      test showed "slitte tråder" matched at 0.526 — below the old floor
#      but a genuinely useful precedent.)
# ---------------------------------------------------------------------------
RAG_FLOOR_FAQ=0.55
RAG_FLOOR_PRODUCTS=0.50
RAG_FLOOR_TICKETS=0.45
