# =============================================================================
# Visor AI Agent — example environment configuration
# =============================================================================
#
# Copy to .env and fill in real values. NEVER commit .env to git.
#
# Required secrets are marked REQUIRED. Tunables are marked TUNABLE with
# their current production defaults.
# =============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# ---------------------------------------------------------------------------
# OpenAI (REQUIRED)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Pinecone (REQUIRED)
# ---------------------------------------------------------------------------
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=ai-agent-knowledge

# ---------------------------------------------------------------------------
# Postgres (REQUIRED)
# Example: postgres://user:pass@localhost:5432/visor_agent
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://...

# ---------------------------------------------------------------------------
# Magento (REQUIRED for order lookups)
# Use https://visor.no/rest/V1 for production
# ---------------------------------------------------------------------------
MAGENTO_API_URL=https://visor.no/rest/V1
MAGENTO_API_TOKEN=...

# ---------------------------------------------------------------------------
# Admin dashboard (REQUIRED)
# Random 64-char hex string. Rotate if leaked.
# ---------------------------------------------------------------------------
ADMIN_API_KEY=...

# ---------------------------------------------------------------------------
# RAG confidence floors (TUNABLE)
# ---------------------------------------------------------------------------
# Minimum cosine similarity required for a retrieval to be considered
# "confident enough" to use. Below this, the agent returns NO_KNOWLEDGE_BASE_DATA
# instead of weak chunks it might synthesize from.
#
# Production-tuned values (do not raise without testing):
#   - FAQs: 0.55  — curated content, semantic match is precise
#   - Products: 0.50  — product names + specs, broader vocabulary
#   - Tickets: 0.45  — colloquial customer language, lower threshold needed
#     (Lowered from 0.55 on 2026-06-04 after the Drop 2 Phase C headline
#      test showed "slitte tråder" matched at 0.526 — below the old floor
#      but a genuinely useful precedent.)
# ---------------------------------------------------------------------------
RAG_FLOOR_FAQ=0.55
RAG_FLOOR_PRODUCTS=0.50
RAG_FLOOR_TICKETS=0.45
#   half-life (days) for the ticket recency nudge in reRankByKeywordOverlap —
#   older tickets get a small smooth penalty (max -0.03) so near-tied matches
#   favor the fresher ticket; a strong old match still beats a weak new one.
TICKET_RECENCY_HALF_LIFE_DAYS=730
# learned_qa (episodic memory) retrieval tuning:
#   floor below which a learned answer is ignored; 0.72-0.95 = hybrid blend (weighed candidate)
RAG_FLOOR_LEARNED=0.72
#   relevance boost added to a learned answer when merged into the fast-path ranked list
RAG_LEARNED_BOOST=0.10
#   score at/above which a learned answer is served verbatim, no LLM loop (short-circuit)
RAG_SHORTCIRCUIT_LEARNED=0.95
#   age (days) past which a learned answer no longer qualifies for the verbatim
#   short-circuit above, even at a qualifying score — it's still used as a
#   candidate the LLM weighs against fresh KB results, just no longer trusted
#   blindly. Prevents a once-approved answer from silently going stale forever.
LEARNED_QA_STALE_DAYS=180
