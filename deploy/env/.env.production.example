# ============================================================================
# Visor.no AI Agent — Production Environment Template
# ============================================================================
# Copy to: server/.env  (chmod 600)
# Replace every REPLACE_ME with the real value.
# Never commit the real .env to git.
# ============================================================================

# --- Node ---
NODE_ENV=production
PORT=5000

# --- OpenAI ---
OPENAI_API_KEY=REPLACE_ME

# --- Pinecone ---
PINECONE_API_KEY=REPLACE_ME
PINECONE_ENVIRONMENT=us-east1-gcp
PINECONE_INDEX_NAME=ai-agent-knowledge

# --- CMS platform (locked to Magento) ---
CMS_PLATFORM=magento

# --- Magento 2 ---
# This file is the PRODUCTION template — it must always point at the live
# store. Never paste in test.visor.no here, even temporarily: this file is
# copied verbatim to the server's real .env, and a stray staging URL will
# silently misroute all live order lookups to the test store.
# If you need a staging deploy, copy this file to a separate .env.staging
# and override these two values there instead of editing this template.
MAGENTO_API_URL=https://visor.no/rest/V1
MAGENTO_STORE_BASE_URL=https://visor.no
MAGENTO_BEARER_TOKEN=REPLACE_ME

# --- WooCommerce (legacy, kept for compatibility; can be removed later) ---
WORDPRESS_API_URL=https://visor.no/wp-json/wc/v3
WOOCOMMERCE_CONSUMER_KEY=REPLACE_ME
WOOCOMMERCE_CONSUMER_SECRET=REPLACE_ME

# --- Auth & secrets ---
ADMIN_API_KEY=REPLACE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_SECRET=REPLACE_ME_GENERATE_WITH_openssl_rand_hex_32

# --- File uploads ---
MAX_FILE_SIZE_MB=50

# --- PostgreSQL (local on the same VM) ---
# The setup-postgres.sh script generates a random password and prints it once.
# Paste it here in place of REPLACE_ME_DB_PASSWORD.
DATABASE_URL=postgres://visor_app:REPLACE_ME_DB_PASSWORD@localhost:5432/visor_agent
DB_SSL=false
